# 复制为 .env 并填写

# LLM 剪辑决策（三选一）
# OpenAI
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 或用 DeepSeek：取消下面注释并填 key
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 或用通义千问：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 平台账号（RPA 首次需手动扫码登录，登录态存在 state/browser_profiles/）
DOUYIN_ACCOUNT=
XIAOHONGSHU_ACCOUNT=
SHIPINHAO_ACCOUNT=
KUAISHOU_ACCOUNT=
